<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ah_bg_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@android:color/white"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ah_integration_dashboard"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/ah_blue"
            android:layout_gravity="end"
            android:id="@+id/btn_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ah_done"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/dashboard_tabs"
        android:background="@drawable/dashboard_tab_layout_bg"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tab_general_info"
            android:background="@drawable/dashboard_selected_tab_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ah_general_info"
            android:layout_weight="1"
            android:paddingVertical="4dp"/>
        <View
            android:id="@+id/tab_separator1"
            android:background="#4d000000"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="4dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/tab_mediations"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ah_mediations"
            android:layout_weight="1"
            android:paddingVertical="4dp"/>
        <View
            android:id="@+id/tab_separator2"
            android:background="#4d000000"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:alpha="0.3"
            android:layout_marginVertical="4dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/tab_ad_networks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ah_ad_networks"
            android:layout_weight="1"
            android:paddingVertical="4dp"/>
        <View
            android:id="@+id/tab_separator3"
            android:background="#4d000000"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:alpha="0.3"
            android:layout_marginVertical="4dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/tab_features"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ah_features_test"
            android:layout_weight="1"
            android:paddingVertical="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="#000000"
        android:id="@+id/tv_features_test_disclaimer"
        android:background="@drawable/ah_white_rounded_corners_shape"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/ah_features_test_disclaimer"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_general_info_section"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_mediations_section"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_ad_networks_section"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_features_test_section"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>
