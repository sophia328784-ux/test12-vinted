<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/view_chat_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no">
        <com.vinted.views.common.VintedImageView
            android:id="@+id/view_chat_avatar"
            android:saveEnabled="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vinted_chat_avatar_left_margin"
            android:layout_marginRight="@dimen/vinted_chat_avatar_right_margin"
            app:vinted_image_size="medium"
            app:vinted_image_style="circle"
            app:vinted_scaling="cover"/>
        <com.vinted.views.containers.VintedBubbleView
            android:id="@+id/view_chat_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/view_chat_inner_view_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes">
                <com.vinted.views.containers.VintedLinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showDividers="middle"
                    app:vinted_divider_type="spacer"
                    app:vinted_spacer_size="medium">
                    <com.vinted.views.common.VintedTextView
                        android:id="@+id/view_chat_text"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        app:vinted_text_type="body"/>
                    <com.vinted.views.common.VintedButton
                        android:id="@+id/view_chat_button"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:vinted_button_size="medium"
                        app:vinted_button_style="filled"/>
                    <com.vinted.views.common.VintedTextView
                        android:id="@+id/view_chat_button_caption"
                        android:focusable="true"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        app:vinted_text_style="muted"
                        app:vinted_text_type="caption"/>
                </com.vinted.views.containers.VintedLinearLayout>
            </LinearLayout>
        </com.vinted.views.containers.VintedBubbleView>
        <FrameLayout
            android:id="@+id/view_chat_image_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.vinted.views.common.VintedImageView
                android:id="@+id/view_chat_image"
                android:layout_width="@dimen/vinted_chat_image_size"
                android:layout_height="@dimen/vinted_chat_image_size"
                app:vinted_aspect_ratio="landscape"
                app:vinted_image_size="medium"
                app:vinted_image_style="rounded"
                app:vinted_scaling="cover"/>
            <com.vinted.views.containers.VintedPlainCell
                android:id="@+id/view_chat_photo_reveal"
                android:visibility="gone"
                android:layout_width="@dimen/vinted_chat_image_size"
                android:layout_height="@dimen/vinted_chat_image_size"
                app:vinted_cell_theme="amplified">
                <com.vinted.views.common.VintedTextView
                    android:ellipsize="end"
                    android:id="@+id/view_chat_suspicious_photo_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:vinted_text_alignment="center"
                    app:vinted_text_type="subtitle"/>
            </com.vinted.views.containers.VintedPlainCell>
        </FrameLayout>
    </LinearLayout>
    <com.vinted.views.common.VintedTextView
        android:layout_gravity="right"
        android:id="@+id/view_chat_seen_marker"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:vinted_text_type="caption"/>
</merge>
