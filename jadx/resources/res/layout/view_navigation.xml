<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.vinted.views.common.VintedTextView
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/navigation_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <FrameLayout
        android:layout_gravity="start|center_vertical"
        android:id="@+id/navigation_left_action_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.vinted.views.common.VintedIconButton
            android:id="@+id/navigation_left_action"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:vinted_icon_position="left"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/navigation_right_action_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.vinted.views.common.VintedIconButton
            android:id="@+id/navigation_right_action"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:vinted_icon_position="left"/>
    </FrameLayout>
</merge>
