<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/klarna_msdk_internal_browser_root"
    android:background="@color/background_browser_klarna_inapp_sdk"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/klarna_msdk_internal_browser_close_icon"
        android:layout_above="@+id/guideline"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/klarna_msdk_internal_browser_close_icon">
        <ImageView
            android:id="@+id/klarna_msdk_internal_browser_lock_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginLeft="8dp"
            android:src="@drawable/lock_klarna_inapp_sdk"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/color_address_klarna_inapp_sdk"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/klarna_msdk_internal_browser_address_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/klarna_msdk_internal_browser_close_icon"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="?android:attr/actionBarSize"
        android:layout_height="?android:attr/actionBarSize"
        android:src="0x7f080294"
        android:tint="@android:color/black"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/guideline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/klarna_msdk_internal_browser_close_icon"/>
    <ProgressBar
        android:id="@+id/klarna_msdk_internal_browser_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progressDrawable="@drawable/progress_browser_klarna_inapp_sdk"
        android:layout_above="@+id/guideline"
        style="?android:attr/progressBarStyleHorizontal"/>
    <WebView
        android:id="@+id/klarna_msdk_internal_browser_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/klarna_msdk_internal_browser_base_bar"
        android:layout_alignTop="@+id/guideline"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/klarna_msdk_internal_browser_base_bar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_alignParentBottom="true">
        <com.klarna.mobile.sdk.core.webview.ui.TintableImageView
            android:id="@+id/klarna_msdk_internal_browser_back_icon"
            android:layout_width="?android:attr/actionBarSize"
            android:layout_height="match_parent"
            android:src="0x7f0801b1"
            app:tintColorStateList="@color/btn_nav_tint_klarna_inapp_sdk"/>
        <com.klarna.mobile.sdk.core.webview.ui.TintableImageView
            android:id="@+id/klarna_msdk_internal_browser_forward_icon"
            android:layout_width="?android:attr/actionBarSize"
            android:layout_height="match_parent"
            android:src="0x7f08040c"
            app:tintColorStateList="@color/btn_nav_tint_klarna_inapp_sdk"/>
    </LinearLayout>
</RelativeLayout>
