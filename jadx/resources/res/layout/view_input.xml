<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vinted.views.common.VintedTextView
        android:id="@+id/view_input_title"
        android:saveEnabled="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@+id/view_input_value"/>
    <FrameLayout
        android:id="@+id/view_input_value_container"
        android:addStatesFromChildren="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vinted.views.common.SelectionAwareEditText
            android:id="@+id/view_input_value"
            android:background="@null"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.vinted.views.common.VintedIconView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/view_input_icon"
            android:saveEnabled="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.vinted.views.common.VintedTextView
        android:id="@+id/view_input_note"
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <com.vinted.views.common.VintedValidationView
        android:id="@+id/view_input_validation"
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"/>
</merge>
