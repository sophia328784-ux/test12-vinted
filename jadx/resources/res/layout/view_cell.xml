<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.vinted.views.common.VintedImageView
            android:layout_gravity="top|left"
            android:id="@+id/view_cell_image"
            android:visibility="gone"
            android:saveEnabled="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/view_cell_body_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/view_cell_title_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vinted.views.common.VintedTextView
                    android:id="@+id/view_cell_title"
                    android:saveEnabled="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.vinted.views.common.VintedTextView
                    android:layout_gravity="top|right"
                    android:id="@+id/view_cell_subtitle"
                    android:saveEnabled="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"/>
            </LinearLayout>
            <com.vinted.views.common.VintedTextView
                android:id="@+id/view_cell_body"
                android:saveEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <com.vinted.views.common.VintedValidationView
        android:id="@+id/view_cell_validation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
