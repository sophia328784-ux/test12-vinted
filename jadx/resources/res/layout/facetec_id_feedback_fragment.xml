<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/backgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:translationY="-55dp">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/iconFrameLayout"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_centerInParent="true">
                <RelativeLayout
                    android:id="@+id/iconImageContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/backIconImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/facetec_internal_id_card_back"
                        android:scaleType="fitCenter"
                        android:layout_centerInParent="true"
                        android:alpha="0"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/frontIconImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/facetec_internal_id_card_front"
                        android:scaleType="fitCenter"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
            </FrameLayout>
            <TextView
                android:textSize="20sp"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/messageTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/FaceTec_idscan_feedback_flip_id_to_back_message"
                android:includeFontPadding="false"
                android:layout_below="@+id/iconFrameLayout"
                android:layout_centerHorizontal="true"
                android:lineSpacingMultiplier="1.1"
                android:textAlignment="center"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
